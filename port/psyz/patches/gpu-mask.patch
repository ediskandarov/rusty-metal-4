+// Slow path only for protected transfers. Drawing normally stays on the GPU.
+static void ProtectUploadedPixels(const PS1_RECT* rect, u8* pixels) {
+    SDL_Rect area = {rect->x, rect->y, rect->w, rect->h};
+    SDL_Rect vram = {0, 0, VRAM_W, VRAM_H}, clipped;
+    if (!SDL_GetRectIntersection(&area, &vram, &clipped)) return;
+    SyncDirtyCanvases(&clipped);
+    u8* previous = malloc((size_t)clipped.w * clipped.h * 4);
+    if (!previous) { ERRORF("mask readback allocation failed"); return; }
+    GLint read_fbo;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fbo);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, vram_fbo);
+    glReadPixels(clipped.x, clipped.y, clipped.w, clipped.h,
+                 GL_RGBA, GL_UNSIGNED_BYTE, previous);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fbo);
+    for (int y = 0; y < clipped.h; y++) {
+        for (int x = 0; x < clipped.w; x++) {
+            const u8* old = previous + (y * clipped.w + x) * 4;
+            if (old[3] >= 128) {
+                u8* pixel = pixels + ((y + clipped.y - rect->y) * rect->w +
+                                      x + clipped.x - rect->x) * 4;
+                memcpy(pixel, old, 4);
+            }
+        }
+    }
+    free(previous);
+}
