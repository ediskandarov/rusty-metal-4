 static PsyzVSyncCb g_PsyzVsyncCb = NULL;
+static unsigned int display_vblank_clock;
+
+void Psyz_ResetDisplayClock(void) {
+    display_vblank_clock = (unsigned int)Psyz_VideoVSync(-1);
+}
+
+/* Advance emulated VBlanks independently of presentation. */
+unsigned int Psyz_PollDisplayClock(void) {
+    unsigned int now = (unsigned int)Psyz_VideoVSync(-1);
+    unsigned int elapsed = now - display_vblank_clock;
+    display_vblank_clock = now;
+    Psyz_KernelPoll();
+    /* Do not replay a background tab's entire interrupt backlog. */
+    if (elapsed > 8) elapsed = 0;
+    if (elapsed) {
+        pads_sampled = 0;
+        ReadPadsOnVsync();
+    }
+    for (unsigned int i = 0; i < elapsed; ++i) {
+        if (g_PsyzVsyncCb) g_PsyzVsyncCb();
+        Psyz_KernelVBlank();
+    }
+    return elapsed;
+}
