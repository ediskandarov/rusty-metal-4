+/* PsyQ packets have no texture allocation metadata. Use the complete primitive's
+ * UV rectangle as a conservative filter boundary, never the entire VRAM atlas. */
+static void EnqueueFilteredPrimitive(int vertices, int indices) {
+    int x0 = 255, y0 = 255, x1 = 0, y1 = 0;
+    for (int i = 0; i < vertices; i++) {
+        int u = vertex_cur[i].u, v = vertex_cur[i].v;
+        if (u < x0) x0 = u;
+        if (v < y0) y0 = v;
+        if (u > x1) x1 = u;
+        if (v > y1) y1 = v;
+    }
+    if (x1 > 255) x1 = 255;
+    if (y1 > 255) y1 = 255;
+    SDL_Rect region = {x0, y0, x1 - x0 + 1, y1 - y0 + 1};
+    for (int i = 0; i < vertices; i++) texture_regions[n_vertices + i] = region;
+    Draw_EnqueueBuffer(vertices, indices);
+}
