+static bool SameTextureView(const PsyzTextureView* a, const PsyzTextureView* b) {
+    return a->page == b->page && a->clut == b->clut && a->window == b->window &&
+        a->x == b->x && a->y == b->y && a->width == b->width && a->height == b->height;
+}
