+/* PsyQ PutDispEnv uses these scanout origins for screen.x/y == 0.
+ * Keep its centering controls relative to the fitted display, not VRAM.
+ * Horizontal units are GPU clocks; the standard display spans 2560 clocks.
+ * This does not simulate analog overscan or interlace timing. */
+static SDL_Rect OffsetAndClipDisplay(SDL_Rect rect, int window_height) {
+    if (debug_show_vram) {
+        return rect;
+    }
+    glEnable(GL_SCISSOR_TEST);
+    glScissor(rect.x, window_height - rect.y - rect.h, rect.w, rect.h);
+    rect.x += (int)lroundf(((int)display_horizontal_start - 0x260) *
+                          (float)rect.w / 2560.0f);
+    rect.y += (int)lroundf(((int)display_vertical_start -
+                           (display_pal ? 0x13 : 0x10)) *
+                          (float)rect.h / (display_pal ? 288.0f : 240.0f));
+    return rect;
+}
