+static PsyzPresentFilter present_filter;
+
+void Psyz_SetPresentFilter(PsyzPresentFilter filter) {
+    present_filter = filter;
 }
 
+static void PresentImage(int sx0, int sy0, int sx1, int sy1,
+                         int dx0, int dy0, int dx1, int dy1) {
+    if (present_filter) {
+        GLint framebuffer;
+        glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &framebuffer);
+        const int source[4] = {sx0, sy0, sx1, sy1};
+        const int destination[4] = {dx0, dy0, dx1, dy1};
+        if (present_filter((unsigned)framebuffer, source, destination)) {
+            return;
+        }
+    }
+    glBlitFramebuffer(sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1,
+                      GL_COLOR_BUFFER_BIT, GL_NEAREST);
+}
