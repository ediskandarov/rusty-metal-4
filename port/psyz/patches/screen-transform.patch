     "layout(location = 2) in vec4 color;\n"
     "layout(location = 3) in vec4 twin;\n"
     "layout(location = 4) in float invDepth;\n"
+    "layout(location = 5) in float transformedSprite;\n"
     "uniform vec2 resolution;\n"
     "uniform vec2 drawOffset, halfPixel, targetSize;\n"
     "out vec4 vertexColor;\n"
@@ -89,7 +90,9 @@
     "    tpage = texWord & 0x1FFu;\n"
     "    textureBank = (texWord >> 9u) & 15u;\n"
     "    dither = (texWord & 0x4000u) != 0u ? 1u : 0u;\n"
-    "    rawUV = tex.xy + shift - halfPixel;\n"
+    // Keep the sprite flag separate from TPAGE texture-bank bits.
+    "    vec2 uvBias = transformedSprite != 0.0 ? vec2(0.0) : halfPixel;\n"
+    "    rawUV = tex.xy + shift - uvBias;\n"
     // Keep clip W at 1 so coverage and Gouraud colors stay unchanged.
     // Screen-space interpolation of (uv/z, 1/z) corrects UVs alone.
     "    weightedUV = vec3(rawUV * invDepth, invDepth);\n"
@@ -1387,5 +1390,8 @@
     glVertexAttribPointer(4, 1, GL_FLOAT, GL_FALSE, sizeof(Vertex),
                           (void*)offsetof(Vertex, inv_depth));
     glEnableVertexAttribArray(4);
+    glVertexAttribPointer(5, 1, GL_FLOAT, GL_FALSE, sizeof(Vertex),
+                          (void*)offsetof(Vertex, transformed_sprite));
+    glEnableVertexAttribArray(5);
     glBindVertexArray(0);
 }
