--- a/platform/sdl3_draw.h
+++ b/platform/sdl3_draw.h
@@ -34,6 +34,7 @@
     unsigned int twin;
 #ifdef PSYZ_FLOAT_VERTEX_POSITION
     float inv_depth;
+    float transformed_sprite;
 #endif
 } Vertex;
 
@@ -79,10 +80,31 @@
         Draw_FlushBuffer();
     }
 }
+#ifdef PSYZ_FLOAT_VERTEX_POSITION
+static float screen_scale = 1.0f, screen_x, screen_y;
+
+void Psyz_DrawSetScreenTransform(float scale, float x, float y) {
+    screen_scale = scale;
+    screen_x = x;
+    screen_y = y;
+}
+#endif
+
 static void Draw_EnqueueBuffer(int vertices, int indices) {
     assert(n_vertices + vertices <= MAX_VERTEX_COUNT);
     assert(n_indices + indices <= MAX_INDEX_COUNT);
 
+#ifdef PSYZ_FLOAT_VERTEX_POSITION
+    for (int i = 0; i < vertices; ++i) {
+        vertex_cur[i].transformed_sprite = 0.0f;
+        if (screen_scale != 1.0f || screen_x != 0.0f || screen_y != 0.0f) {
+            vertex_cur[i].x = vertex_cur[i].x * screen_scale + screen_x;
+            vertex_cur[i].y = vertex_cur[i].y * screen_scale + screen_y;
+            if (!(vertex_cur[i].t & (TPAGE_POLYGON | TPAGE_NOTEXTURE)))
+                vertex_cur[i].transformed_sprite = 1.0f;
+        }
+    }
+#endif
     vertex_cur += vertices;
     index_cur += indices;
     n_vertices += vertices;
