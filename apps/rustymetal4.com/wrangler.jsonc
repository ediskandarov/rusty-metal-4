{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tm4-rewired-test",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "routes": [{ "pattern": "rustymetal4.com", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "../../build/release/rustymetal4.com-site",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": { "CONTAINER_VCPU": "0.25" },
  "observability": { "enabled": true },
  "analytics_engine_datasets": [{ "binding": "HEALTH", "dataset": "rustymetal4_server_health" }],
  "containers": [
    {
      "class_name": "TestServer",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile", "build_context": "../.." } },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SERVER", "class_name": "TestServer" },
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "RoomDirectory" },
    ],
  },
  "exports": {
    "TestServer": { "type": "durable-object", "storage": "sqlite" },
    "Room": { "type": "durable-object", "storage": "sqlite" },
    "RoomDirectory": { "type": "durable-object", "storage": "sqlite" },
  },
  "ratelimits": [
    { "name": "CREATION_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "REQUEST_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
  ],
  "dev": { "enable_containers": false },
}
