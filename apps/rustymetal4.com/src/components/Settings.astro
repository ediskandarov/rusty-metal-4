---
import { ffaDefaultLimits } from "@tm4/lightyear-client/schemas";
import { maps, modes } from "@tm4/rooms-client/schemas";
interface Props {
  prefix: string;
}
const { prefix } = Astro.props;
---

<label for={`${prefix}-name`}>
  Room name
  <input id={`${prefix}-name`} name="name" maxlength="48" required />
</label>
<label for={`${prefix}-mode`}>
  Game mode
  <select id={`${prefix}-mode`} name="modeId">
    {modes.map((mode) => (
      <option value={mode.id}>{mode.label}</option>
    ))}
  </select>
</label>
<label for={`${prefix}-map`}>
  Map
  <select id={`${prefix}-map`} name="mapId">
    {maps.map((map) => (
      <option value={map.id}>{map.label}</option>
    ))}
  </select>
</label>

<p>
  {ffaDefaultLimits.timeLimitTicks / 30 / 60} minutes or {ffaDefaultLimits.fragLimit} frags. Limits
  are fixed for this match.
</p>
