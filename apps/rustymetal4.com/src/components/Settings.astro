---
import { ffaDefaultLimits } from "@tm4/lightyear-client/schemas";
import { maps, modes } from "@tm4/rooms-client/schemas";
interface Props {
  prefix: string;
}
const { prefix } = Astro.props;
---

<label for={`${prefix}-name`}>
  Room name
  <input id={`${prefix}-name`} name="name" maxlength="48" required />
</label>
<label for={`${prefix}-mode`}>
  Game mode
  <select id={`${prefix}-mode`} name="modeId">
    {modes.map((mode) => (
      <option value={mode.id}>{mode.label}</option>
    ))}
  </select>
</label>
<label for={`${prefix}-map`}>
  Map
  <select id={`${prefix}-map`} name="mapId">
    {maps.map((map) => (
      <option value={map.id}>{map.label}</option>
    ))}
  </select>
</label>

<fieldset data-mode-settings="ffa">
  <legend>Free for all</legend>
  <label>
    Bot places — choose their starting cars
    <select name="bots" id={`${prefix}-bots`} multiple size="5" disabled />
  </label>
  <label for={prefix + "-human-limit"}>
    Maximum human players
    <input
      id={prefix + "-human-limit"}
      name="humanLimit"
      type="number"
      min="1"
      max="8"
      value="8"
      required
    />
  </label>
  <p id={prefix + "-bots-help"}>Load your disc to choose bots. Empty places stay empty.</p>
  <p>
    {ffaDefaultLimits.timeLimitTicks / 30 / 60} minutes or {ffaDefaultLimits.fragLimit} frags.
    Limits are fixed for this match.
  </p>
  <p>Humans can join during the match within their limit. Bot places stay reserved for bots.</p>
</fieldset>

<fieldset data-mode-settings="tournament" hidden>
  <legend>Tournament</legend>
  <p>
    Two players choose their cars in the game. The first battle uses the original tournament rules.
  </p>
</fieldset>
