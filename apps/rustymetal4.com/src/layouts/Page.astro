---
import "../styles/main.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Rusty Metal 4 · {title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">Rusty Metal 4</p>
      <slot />
    </main>
    <script>
      import "../client.ts";
    </script>
  </body>
</html>
