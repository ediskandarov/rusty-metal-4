---
import "../styles/main.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
const commit = import.meta.env.PUBLIC_BUILD_COMMIT;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Rusty Metal 4 · {title}</title>
    <script>
      import "../analytics.ts";
    </script>
  </head>
  <body>
    <main>
      <header class="site-header">
        <a class="site-title" href="/">
          Rusty Metal 4
        </a>
      </header>
      <slot />
    </main>
    <footer class="build-version">
      Build{" "}
      <a
        href={`https://github.com/ediskandarov/rusty-metal-4/commit/${commit}`}
        title={commit}
        target="_blank"
        rel="noopener noreferrer"
      >
        <code>{commit.slice(0, 7)}</code>
      </a>
    </footer>
    <script>
      import "../client.ts";
    </script>
  </body>
</html>
