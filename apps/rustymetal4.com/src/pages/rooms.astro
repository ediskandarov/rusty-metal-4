---
import Page from "../layouts/Page.astro";
import Settings from "../components/Settings.astro";
---

<Page title="Room">
  <p>
    <a href="/">All rooms</a>
  </p>
  <div data-page="room">
    <h1 id="room-name">Opening room…</h1>
    <p id="room-status" role="status">
      Connecting…
    </p>
    <p id="room-error" class="error" role="alert" hidden></p>
  </div>
  <div id="room-content" hidden>
    <section aria-labelledby="participants-heading">
      <dl class="room-parameters">
        <div>
          <dt>Game mode</dt>
          <dd id="room-mode"></dd>
        </div>
        <div>
          <dt>Map</dt>
          <dd id="room-map"></dd>
        </div>
        <div>
          <dt>Players / limit</dt>
          <dd id="room-capacity"></dd>
        </div>
        <div>
          <dt>Available slots</dt>
          <dd id="room-free"></dd>
        </div>
      </dl>
      <h2 id="participants-heading">
        Participants (<span id="member-count"></span>)
      </h2>
      <ol id="participants" aria-live="polite"></ol>
      <p>
        Before a match, a lost connection holds your place for 45 seconds. During a match, the fixed
        participants can reconnect; an empty match stops after two minutes. If the host leaves,
        another participant becomes the host.
      </p>
      <button id="leave-button" type="button" hidden>
        Leave room
      </button>
    </section>
    <section aria-labelledby="invite-heading">
      <h2 id="invite-heading">Invite players</h2>
      <label for="invite-link">
        Invite link
        <input id="invite-link" readonly />
      </label>
      <button id="copy-invite" type="button">
        Copy invite link
      </button>
      <p id="copy-status" role="status"></p>
    </section>
    <section id="join-panel" hidden>
      <h2>Join room</h2>
      <form id="join-form">
        <label for="join-player">
          Your name
          <input
            id="join-player"
            name="playerName"
            autocomplete="nickname"
            maxlength="24"
            required
          />
        </label>
        <p id="join-error" class="error" role="alert" hidden></p>
        <button type="submit">Join room</button>
      </form>
    </section>
    <section id="results-panel" hidden>
      <h2>Final scoreboard</h2>
      <p id="results-reason"></p>
      <table class="scoreboard">
        <thead>
          <tr>
            <th scope="col">Player</th>
            <th scope="col">Frags</th>
            <th scope="col">Deaths</th>
            <th scope="col">Result</th>
          </tr>
        </thead>
        <tbody id="results-rows"></tbody>
      </table>
      <button id="return-to-room" type="button">
        Return to room
      </button>
    </section>
    <section id="match-panel" hidden>
      <h2>Match preparation</h2>
      <p id="match-status" role="status"></p>
      <p>
        Each player loads their own disc below. Only the host uploads required resources to the
        private match server. Start with 2–8 ready players; empty slots do not need to be filled.
      </p>
      <label for="room-car">
        Your car{" "}
        <select id="room-car" disabled>
          <option value="">Load your disc first</option>
        </select>
      </label>
      <button id="room-ready" type="button" disabled>
        Ready
      </button>
      <button id="prepare-match" type="button" hidden>
        Prepare server from my disc
      </button>
      <button id="cancel-preparation" type="button" hidden>
        Cancel preparation
      </button>
      <button id="start-match" type="button" hidden>
        Start match
      </button>
      <button id="reconnect-match" type="button" hidden>
        Reconnect game
      </button>
      <button id="download-server-journal" type="button" hidden>
        Download server journal
      </button>
      <p id="server-journal-status" role="status"></p>
      <p id="player-status" role="status"></p>
      <iframe
        id="room-player"
        title="Local disc and game"
        allow="cross-origin-isolated; gamepad; fullscreen"
        hidden
      ></iframe>
    </section>
    <section id="settings-panel" hidden>
      <h2>Room settings</h2>
      <p>Only the host can change these settings.</p>
      <form id="settings-form">
        <Settings prefix="edit" />
        <p id="settings-error" class="error" role="alert" hidden></p>
        <button type="submit">Save settings</button>
        <p id="settings-status" role="status"></p>
      </form>
    </section>
  </div>
  <template id="participant-template">
    <li class="participant">
      <span class="participant-name"></span>
      <span class="participant-role"></span>
      <span class="participant-presence"></span>
    </li>
  </template>
</Page>
