---
import Page from "../layouts/Page.astro";
import { challengeMaps, challengeModels } from "../challenge.ts";
---

<Page title="200 Challenge">
  <h1>200 Challenge</h1>
  <p>Your car. 200 enemies. One survivor.</p>
  <p>Pick a car. Pick an arena. Be the last one standing.</p>
  <h2>The rules</h2>
  <ul>
    <li>You and 200 opponents drive the same car. Everyone fights everyone.</li>
    <li>One life. No respawns.</li>
    <li>Unlimited specials. Original cooldowns.</li>
    <li>No shields, invisibility or teleportation.</li>
  </ul>
  <h2>Survive. Switch cars. Do it again.</h2>
  <p>
    Win on any map to master your chosen car. Each different car adds one point
    to your score. Winning with the same car again earns bragging rights.
  </p>
  <section aria-labelledby="challenge-driver-heading">
    <h2 id="challenge-driver-heading">Your name</h2>
    <form id="challenge-name-form">
      <label for="challenge-name">
        Display name
        <input
          id="challenge-name"
          name="name"
          autocomplete="nickname"
          maxlength="24"
          required
        />
      </label>
      <button type="submit">Save name</button>
    </form>
    <p id="challenge-profile" role="status">
      Loading your driver…
    </p>
    <p>Your progress is saved in this browser.</p>
  </section>
  <section aria-labelledby="challenge-play-heading" class="challenge-play">
    <h2 id="challenge-play-heading">Play</h2>
    <p>
      You need your own Twisted Metal 4 disc files. They stay on your computer.
    </p>
    <p id="challenge-release" role="status">
      Checking the pinned challenge build…
    </p>
    <button id="challenge-launch" type="button" disabled>
      Take the wheel
    </button>
    <p id="challenge-game-status" role="status"></p>
    <p id="challenge-error" class="error" role="alert" hidden></p>
    <iframe
      id="challenge-player"
      title="200 Challenge game player"
      allow="autoplay; fullscreen"
      allowfullscreen
      hidden
    ></iframe>
  </section>
  <section aria-labelledby="challenge-leaderboard-heading">
    <h2 id="challenge-leaderboard-heading">Leaderboard</h2>
    <p id="challenge-board-status" role="status">
      Loading completions…
    </p>
    <div class="room-table-scroll">
      <table class="room-table challenge-leaderboard">
        <thead>
          <tr>
            <th scope="col">Driver</th>
            <th scope="col">Cars mastered</th>
          </tr>
        </thead>
        <tbody id="challenge-board"></tbody>
      </table>
    </div>
  </section>
  <details>
    <summary>Cars &amp; arenas</summary>
    <p>{challengeMaps.join(" · ")}</p>
    <p>
      {challengeModels.length} original cars: {challengeModels.join(" · ")}
    </p>
  </details>
  <script>
    import "../challenge-client.ts";
  </script>
</Page>
<style>
  .challenge-leaderboard {
    min-width: 0;
    table-layout: fixed;
  }
  :global(#challenge-board th),
  :global(#challenge-board td) {
    vertical-align: top;
  }
  :global(#challenge-board .challenge-wins) {
    margin-top: 0.4rem;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  :global(#challenge-board .challenge-wins summary) {
    cursor: pointer;
    color: var(--accent, #e9aa55);
  }
  :global(#challenge-board .challenge-wins ul) {
    padding-left: 1.2rem;
    margin: 0.6rem 0 0;
  }
  :global(#challenge-board .challenge-wins li + li) {
    margin-top: 0.4rem;
  }
  .challenge-play iframe {
    width: 100%;
    height: min(780px, 85svh);
    border: 1px solid #354151;
    margin-top: 20px;
  }
  .challenge-play iframe[hidden] {
    display: none;
  }
</style>
