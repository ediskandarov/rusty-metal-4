---
import Page from "../layouts/Page.astro";
import { Content as Intro } from "../content/intro.md";
import { Content as RoomHelp } from "../content/rooms.md";
---

<Page title="Play">
  <div class="intro">
    <Intro />
    <div class="intro-actions">
      <a class="button" href="/play/">
        Play Disk
      </a>
      <a class="button button-secondary" href="#network-play">
        Play Online
      </a>
    </div>
  </div>
  <h2 id="network-play" class="network-heading" tabindex="-1">
    Network Play
  </h2>
  <RoomHelp />
  <section data-page="directory" aria-labelledby="directory-heading">
    <h3 id="directory-heading">
      Available rooms (<span id="room-count">0</span>)
    </h3>
    <p id="directory-status" role="status">
      Connecting…
    </p>
    <p id="directory-error" class="error" role="alert" hidden></p>
    <div class="room-table-scroll" role="region" aria-labelledby="directory-heading" tabindex="0">
      <table class="room-table" aria-labelledby="directory-heading">
        <thead>
          <tr>
            <th scope="col">Server</th>
            <th scope="col" class="room-players">
              Players
            </th>
            <th scope="col">Mode</th>
            <th scope="col">Map</th>
            <th scope="col" aria-label="Actions"></th>
          </tr>
        </thead>
        <tbody id="rooms" aria-live="polite">
          <tr>
            <td colspan="5">Loading rooms…</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
  <section aria-labelledby="create-heading">
    <h3 id="create-heading">Create room</h3>
    <form id="create-form">
      <label for="create-player">
        Your name
        <input
          id="create-player"
          name="playerName"
          autocomplete="nickname"
          maxlength="24"
          required
        />
      </label>
      <label for="create-name">
        Room name
        <input id="create-name" name="name" maxlength="48" required />
      </label>
      <p id="create-error" class="error" role="alert" hidden></p>
      <button type="submit">Create room</button>
    </form>
    <p>Your browser remembers your membership. No account is needed.</p>
  </section>
  <template id="empty-template">
    <tr>
      <td colspan="5" class="room-empty">
        No public rooms yet.{" "}
        <a href="#create-player" id="first-room">
          Create room
        </a>{" "}
        to invite other players.
      </td>
    </tr>
  </template>
  <template id="room-row-template">
    <tr>
      <th scope="row">
        <a class="room-name" href="/"></a>
      </th>
      <td class="room-players"></td>
      <td class="room-mode"></td>
      <td class="room-map"></td>
      <td class="room-action">
        <a class="button room-join" href="/">
          Join
        </a>
      </td>
    </tr>
  </template>
</Page>
