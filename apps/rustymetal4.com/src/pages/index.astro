---
import Page from "../layouts/Page.astro";
import { Content as RoomHelp } from "../content/rooms.md";
---

<Page title="Play">
  <div class="single-player">
    <a class="button" href="/play/">
      Play Disk
    </a>
    <p>Play single-player using your own game disc.</p>
  </div>
  <h1>Network Play</h1>
  <RoomHelp />
  <section data-page="directory" aria-labelledby="directory-heading">
    <h2 id="directory-heading">
      Available rooms (<span id="room-count">0</span>)
    </h2>
    <p id="directory-status" role="status">
      Connecting…
    </p>
    <p id="directory-error" class="error" role="alert" hidden></p>
    <div id="rooms" class="room-list" aria-live="polite">
      <p>Loading rooms…</p>
    </div>
  </section>
  <section aria-labelledby="create-heading">
    <h2 id="create-heading">Create room</h2>
    <form id="create-form">
      <label for="create-player">
        Your name
        <input
          id="create-player"
          name="playerName"
          autocomplete="nickname"
          maxlength="24"
          required
        />
      </label>
      <label for="create-name">
        Room name
        <input id="create-name" name="name" maxlength="48" required />
      </label>
      <p id="create-error" class="error" role="alert" hidden></p>
      <button type="submit">Create room</button>
    </form>
    <p>Your browser remembers your membership. No account is needed.</p>
  </section>
  <template id="empty-template">
    <p>
      No public rooms yet.{" "}
      <a href="#create-player" id="first-room">
        Create room
      </a>{" "}
      to invite other players.
    </p>
  </template>
  <template id="room-card-template">
    <article class="room-card">
      <h3 class="card-name"></h3>
      <p class="card-host"></p>
      <dl class="room-parameters">
        <div>
          <dt>Game mode</dt>
          <dd class="card-mode"></dd>
        </div>
        <div>
          <dt>Map</dt>
          <dd class="card-map"></dd>
        </div>
        <div>
          <dt>Players / limit</dt>
          <dd class="card-count"></dd>
        </div>
        <div>
          <dt>Available slots</dt>
          <dd class="availability"></dd>
        </div>
      </dl>
      <a class="button" href="/">
        Join room
      </a>
    </article>
  </template>
</Page>
