{
  "name": "@tm4/rustymetal4.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "dev": "bun build.ts && wrangler dev --local --port 8787 --persist-to ../../build/rustymetal4.com-state",
    "deploy": "bun ../../tools/web/deploy.ts",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit -p src/worker/tsconfig.json && bun --bun astro check"
  },
  "dependencies": {
    "@tm4/lightyear-client": "workspace:*",
    "@tm4/rooms-client": "workspace:*",
    "@tm4/rustymetal-server-client": "workspace:*",
    "posthog-js": "1.448.0",
    "zustand": "5.1.0",
    "@tm4/room-player-protocol": "workspace:*"
  }
}
