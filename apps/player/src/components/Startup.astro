---
import { Content as Introduction } from "../content/startup.md";
---

<section id="startup" aria-live="polite">
  <Introduction />
  <label class="disc-picker" for="disc-folder">
    Folder containing one disc
    <small id="disc-formats">CUE + BIN or CCD + IMG files</small>
    <input
      id="disc-folder"
      disabled
      type="file"
      webkitdirectory
      multiple
      aria-label="Game disc folder"
      aria-describedby="disc-formats"
    />
  </label>
  <details id="startup-mods">
    <summary>Optional mods</summary>
    <p>Choose or drop .tm4mod packages anywhere on this page. Saved locally in this browser.</p>
    <input id="startup-mod-files" type="file" accept=".tm4mod" multiple aria-label="Mod packages" />
    <ul id="startup-mod-list" class="mod-list"></ul>
    <p id="startup-mod-status" role="status"></p>
  </details>
  <p id="startup-progress"></p>
  <ul id="startup-warnings"></ul>
</section>
