---
const commit = import.meta.env.PUBLIC_BUILD_COMMIT;
---

<details id="troubleshoot">
  <summary>Troubleshoot</summary>
  <aside class="settings-panel" aria-label="Troubleshoot">
    <p class="build-version">
      Build{" "}
      <a
        href={`https://github.com/ediskandarov/rusty-metal-4/commit/${commit}`}
        title={commit}
        target="_blank"
        rel="noopener noreferrer"
      >
        <code>{commit.slice(0, 7)}</code>
      </a>
    </p>
    <p>
      Client journal keeps the last 300 simulation ticks (10 seconds), including rollbacks, within a
      2 MiB limit. It freezes when the match stops.
    </p>
    <p id="journal-status" role="status">
      No network session recorded yet.
    </p>
    <button id="download-diagnostics" type="button" disabled>
      Download diagnostic ZIP
    </button>
    <p>Starting another network session replaces this journal. Download it before reconnecting.</p>
    <p>Includes both journals, build and match details, and the current game frame.</p>
    <p>No disc files or access credentials are included. Server journals are public.</p>
  </aside>
</details>
