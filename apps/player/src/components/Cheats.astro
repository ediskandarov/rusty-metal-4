---
import { Content as Help } from "../content/cheats.md";
---

<details id="cheat-settings" hidden>
  <summary>Cheats</summary>
  <div id="cheat-panel" class="settings-panel">
    <Help />
    <label title="Original protection; lethal hits can still kill.">
      God mode <input type="checkbox" data-cheat="16" />
    </label>
    <label>
      Stronger projectile knockback <input type="checkbox" data-cheat="8" />
    </label>
    <label>
      Unlock all cars <input type="checkbox" data-cheat="21" />
    </label>
    <h3>Next match</h3>
    <p>Choose before loading a match. Disabling does not undo changes already applied.</p>
    <label>
      Start with 99 ammo <input type="checkbox" data-cheat="1" />
    </label>
    <label>
      Start with 99 freeze shots <input type="checkbox" data-cheat="2" />
    </label>
    <label>
      Start with 99 massive shots <input type="checkbox" data-cheat="3" />
    </label>
    <label>
      Improved homing <input type="checkbox" data-cheat="4" />
    </label>
    <label>
      Faster special recharge <input type="checkbox" data-cheat="5" />
    </label>
    <label>
      Faster projectiles <input type="checkbox" data-cheat="6" />
    </label>
    <label>
      Enemies focus on players <input type="checkbox" data-cheat="7" />
    </label>
    <label>
      Stronger power missiles <input type="checkbox" data-cheat="9" />
    </label>
    <label>
      Low traction <input type="checkbox" data-cheat="15" />
    </label>
    <button id="cheat-reset" type="button">
      Disable cheats
    </button>
  </div>
</details>
