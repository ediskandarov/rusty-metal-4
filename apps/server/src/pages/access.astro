---
import { Content } from "../content/access.md";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Rusty Metal 4 test server</title>
    <style is:inline>
      body {
        background: #111820;
        color: #eee;
        font: 18px system-ui;
        max-width: 30rem;
        margin: 12vh auto;
        padding: 1rem;
      }
      input,
      button {
        font: inherit;
        padding: 0.7rem;
        margin: 0.6rem 0;
        width: 100%;
        box-sizing: border-box;
      }
      button {
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <Content />
    <p id="access-error" hidden role="alert">
      Incorrect access code.
    </p>
    <form method="post" action="/_access">
      <label>
        Access code
        <input
          name="code"
          type="password"
          required
          autocomplete="current-password"
          maxlength="256"
        />
      </label>
      <button>Open server</button>
    </form>
  </body>
</html>
