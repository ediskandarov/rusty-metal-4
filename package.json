{
  "name": "rustymetal4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun tools/build.js",
    "build:dev": "bun tools/build.js --dev",
    "build:diagnostic": "bun tools/build.js --diagnostic",
    "dev": "bun tools/serve.js",
    "dev:diagnostic": "bun tools/serve.js --site build/diagnostic/site",
    "match": "bun tools/network/run.ts",
    "server": "bun tools/network/server.ts",
    "test": "bun test tests/unit",
    "fmt": "bun fmt --no-script tools apps packages tests package.json config tsconfig.json tsconfig.base.json bunfig.toml && bun tools/web/format.ts",
    "fmt:check": "bun fmt --no-script --check tools apps packages tests package.json config tsconfig.json tsconfig.base.json bunfig.toml && bun tools/web/format.ts --check",
    "lint": "bun lint --no-script tools apps packages tests",
    "typecheck": "tsc --noEmit && bun run --filter \"@tm4/*\" typecheck && tsc --noEmit -p tests/rooms/tsconfig.json",
    "test:pages": "bun tests/browser/check_pages.cjs",
    "test:server": "bun tests/browser/check_server.cjs",
    "build:mod": "bun tools/mods/build.ts",
    "build:simulation": "bun tools/headless/build.ts",
    "test:simulation:record": "bun tools/headless/record-browser.cjs",
    "test:simulation": "bun tools/headless/test.ts",
    "build:player": "bun apps/player/build.ts",
    "build:server": "bun apps/server/build.ts",
    "build:server:standalone": "bun tools/network/build-server.ts",
    "test:server:standalone": "bun test tests/server/standalone.test.ts",
    "server:site": "bun tools/network/serve.ts",
    "deploy": "bun tools/web/deploy.ts",
    "deploy:prepare": "bun tools/web/deploy.ts --prepare-only",
    "build:rustymetal4.com": "bun apps/rustymetal4.com/build.ts",
    "dev:rustymetal4.com": "bun run --cwd apps/rustymetal4.com dev",
    "test:room-matches": "bun test tests/unit/room-match.test.ts && bun tests/rooms/matches.ts",
    "test:room-matches:browser": "bun tests/browser/check_room_matches.cjs",
    "test:rooms": "bun tests/rooms/integration.ts",
    "test:rooms:browser": "bun run build:rustymetal4.com && bun tests/browser/check_rooms.cjs && bun tests/browser/check_room_recovery.cjs",
    "setup:cache": "bun tools/cache/setup.ts",
    "postinstall": "bun run setup:cache",
    "test:cache": "bun tests/cache/shared-cargo.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.4",
    "@types/ws": "8.18.1",
    "astro": "7.4.11",
    "coi-serviceworker": "0.1.7",
    "miniflare": "5.20261110.1-beta",
    "playwright": "1.56.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "wrangler": "^4.160.1",
    "ws": "8.18.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@tm4/game-client": "workspace:*",
    "@tm4/resources": "workspace:*"
  }
}
