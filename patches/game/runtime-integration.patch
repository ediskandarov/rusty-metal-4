-#if !defined(TM4_OBJECT_FUNCTION) || TM4_OBJECT_FUNCTION == 0x800197d4
-/* A failed child lookup leaves the VLA scope before the next iteration. */
-/* Keep uppercasing sequenced before the second prefix-path_length query. */
-/* The SDK char return adds an instruction here; retain the observed int call ABI. */
-extern s32 func_8003CDB8(s32);
-/* Registry walk: mutable visitor name lives only through callback and recursion. */
-void ObjectVisitDirectory(char* prefix, RegistryDirectory* directory, Tm4DirectoryVisitor visitor)
-{
-    s32 child_count = RegGetNumberOfDirectoriesP(directory);
-    s32 i;
-    for (i = 0; i < child_count; i++) {
-        char* name = RegGetDirectoryNamePN(directory, i);
-        if (name != NULL) {
-            s32 path_length = strlen(prefix) + strlen(name) + 1;
-            char path[path_length];
-            RegistryDirectory* child;
-            s32 uppercase_initial;
-            strcpy(path, prefix);
-            strcat(path, name);
-            uppercase_initial = func_8003CDB8(path[strlen(prefix)]);
-            path[strlen(prefix)] = uppercase_initial;
-            child = RegGetDirectoryPtrPN(directory, i);
-            if (child == NULL)
-                continue;
-            if (visitor == NULL || visitor(path, child))
-                ObjectVisitDirectory(path, child, visitor);
-        }
-    }
-}
-#endif
-
-#if !defined(TM4_OBJECT_FUNCTION) || TM4_OBJECT_FUNCTION == 0x80019940
-/* Directory traversal needs the main stack for its variable-length paths. */
-s32 ObjectDirectoryRecurse(Tm4DirectoryVisitor visitor)
-{
-    RegistryDirectory* directory = RegGetDirectoryPtrS(OBJECT_REGISTRY_PATH);
-    u32 stack;
-    if (directory == NULL)
-        return 0;
-    StackGetPointer(stack);
-    if (StackIsScratchpad(stack)) {
-        ObjectDirectorySavedStack = (void*)stack;
-        StackSetPointer(MainSavedStack);
-        ObjectVisitDirectory(OBJECT_EMPTY_PATH, directory, visitor);
-        StackSetPointer(ObjectDirectorySavedStack);
-    } else {
-        ObjectVisitDirectory(OBJECT_EMPTY_PATH, directory, visitor);
-    }
-    return 1;
 }
 #endif
 
