+static struct {
+    u32 tick;
+    ScreenMessageQueue queue;
+} NetworkMessages[2 * WebCheckpointHistoryTicks + 1];
+static ScreenMessageQueue* NetworkMessageTick;
+
+void WebScreenBeginPredictedTick(u32 tick)
+{
+    size_t index = tick % ArrayCount(NetworkMessages);
+    NetworkMessages[index].tick = tick;
+    NetworkMessages[index].queue.count = 0;
+    NetworkMessageTick = &NetworkMessages[index].queue;
+}
+
+void WebScreenFinishPredictedTick(void)
+{
+    NetworkMessageTick = NULL;
+}
+
+static void append_local_message(ScreenMessageQueue* queue)
+{
+    if (queue->count == ScreenLocalMessageLimit) {
+        for (s32 i = 1; i < queue->count; ++i)
+            strcpy(queue->messages[i - 1], queue->messages[i]);
+        --queue->count;
+        queue->timer = 60;
+    } else if (!queue->count) {
+        queue->timer = 60;
+    }
+}
+
+EMSCRIPTEN_KEEPALIVE int WebNetConfirmPresentationTick(u32 tick)
+{
+    if (!WebNetRenderedPrediction() || !tick || WebNetReplaying())
+        return 0;
+    size_t index = tick % ArrayCount(NetworkMessages);
+    if (NetworkMessages[index].tick != tick)
+        return 0;
+    NetworkMessages[index].tick = 0;
+    ScreenMessageQueue* confirmed = &NetworkMessages[index].queue;
+    ScreenMessageQueue* visible = &ScreenLocalMessages[0];
+    for (s32 i = 0; i < confirmed->count; ++i) {
+        append_local_message(visible);
+        strcpy(visible->messages[visible->count++], confirmed->messages[i]);
+    }
+    return confirmed->count;
+}
