+s32 IntersectWorldWithRay(
+    SVECTOR* start_world, SVECTOR* end_world, s32 position_mode, Tm4WorldHit* hit)
+{
+    return intersect_world_ray(start_world, end_world, position_mode, NULL, hit);
+}
+
+s32 WebIntersectWorldTwoSided(SVECTOR* start, SVECTOR* end, Tm4WorldHit* hit)
+{
+    Tm4WorldRay reverse = {
+        .origin = { end->vx, end->vy, end->vz },
+        .displacement = { start->vx - end->vx, start->vy - end->vy, start->vz - end->vz },
+    };
+    return intersect_world_ray(start, end, 0, &reverse, hit);
+}
