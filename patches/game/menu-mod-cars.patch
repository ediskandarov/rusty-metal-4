+char* MenuCharacterLabel(char* name)
+{
+    if (!name || !*name)
+        return name;
+    RegistryDirectory* entry = GameGetCharacterNameDirectoryPtr(name);
+    char* label = entry ? RegGetFileDataPS(entry, "realname") : NULL;
+    return label ? label : name;
+}
+
+s32 MenuCharacterHasInfo(char* name)
+{
+    RegistryDirectory* entry = GameGetCharacterNameDirectoryPtr(name);
+    const char* filename = entry ? RegGetFileDataPS(entry, MenuFilenameKey) : NULL;
+    char path[64];
+    if (!filename || strlen(filename) >= 12 || MenuIsBossCarName(name))
+        return 0;
+    snprintf(path, sizeof(path), "/DATA/MENU/%s.TIM", filename);
+    return CDFileExists(path);
+}
