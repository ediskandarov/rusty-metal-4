+u32 VectorLengthRounded12(const VECTOR* vector)
+{
+    unsigned long long sum = (long long)vector->vx * vector->vx + (long long)vector->vy * vector->vy
+        + (long long)vector->vz * vector->vz;
+    return SquareRootInt32((sum >> 12) + ((sum >> 11) & 1));
+}
